# ==============================================================================
# BHARAT UDYAMI - BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env in the backend directory:
#   copy .env.example .env
#
# All values are loaded automatically by the Flask backend at startup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REAL TRANSACTIONAL EMAIL / SMTP (Required for Forgot Password & OTP)
# ------------------------------------------------------------------------------
# Choose one of the following providers:
#
# OPTION A: Google Gmail (Free & Instant)
# - Enable 2-Step Verification on your Google account.
# - Go to: https://myaccount.google.com/apppasswords
# - Generate an App Password for "Bharat Udyami" (16 characters, e.g. 'abcd efgh ijkl mnop')
# - Set variables below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=Bharat Udyami Security
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# OPTION B: Brevo / Sendinblue (Free 300 emails/day)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login
# SMTP_PASSWORD=your_brevo_smtp_key

# ------------------------------------------------------------------------------
# 2. REAL AI SCENE EDITING, INPAINTING & BACKGROUND TRANSFORMATION
# ------------------------------------------------------------------------------
# The AI Photo Studio uses real-time AI inpainting / scene transformation to place
# handcrafted products into realistic, premium photography environments while
# strictly preserving 100% of authentic product pixels.
#
# OPTION A: Google Gemini / Imagen 3 API (Recommended for Scene Inpainting)
# - Get free API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OPTION B: Clipdrop by Stability AI (Background Replacement API)
# - Sign up at: https://clipdrop.co/apis
CLIPDROP_API_KEY=your_clipdrop_api_key_here

# OPTION C: remove.bg (Cutout & Segmentation API, 50 free credits/month)
# - Sign up free at: https://www.remove.bg/api
REMOVE_BG_API_KEY=your_remove_bg_key_here
